# Restaurant Platform - Environment Configuration

# ===== DATABASE CONFIGURATION =====
# Set to 'true' to use Supabase (cloud PostgreSQL)
# Set to 'false' or leave empty to use lowdb (local JSON file)
USE_SUPABASE=false

# Supabase Credentials (get these from https://supabase.com/dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# ===== JWT CONFIGURATION =====
# Secret key for signing JWT tokens (change this in production)
JWT_SECRET=replace_with_a_secure_random_secret

# ===== AI ASSISTANT CONFIGURATION =====
# Optional: set this locally only if you want the AI assistant enabled.
GOOGLE_API_KEY=your_google_api_key_here

# ===== SERVER CONFIGURATION =====
# Port for the Express server
PORT=3000

# ===== NOTES =====
# 1. Copy this file to .env and fill in your own values for local development
# 2. For local development, keep USE_SUPABASE=false
# 3. To migrate to Supabase:
#    a. Create tables by running SUPABASE_SCHEMA.sql in Supabase SQL Editor
#    b. Set SUPABASE_URL and SUPABASE_KEY
#    c. Run: node seedMigration.js
#    d. Set USE_SUPABASE=true
#    e. Restart the server
